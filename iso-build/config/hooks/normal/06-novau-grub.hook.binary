#!/bin/sh
# ─── binary hook: GRUB menu text customization ────────────────────────
#
# Live-build generates a working grub.cfg at binary/boot/grub/grub.cfg
# (for BIOS) and binary/EFI/BOOT/grub.cfg (for UEFI). These files have
# correct search/source logic that works on real hardware.
#
# Our previous hook REWROTE the entire grub.cfg with custom search
# commands that worked on VMware but broke on real hardware, dropping
# to the grub> rescue prompt. This hook is much simpler: it just renames
# the menu entries from "Debian GNU/Linux Live" to "NovauOS" using sed,
# without touching the structural commands.
#
set -e

echo "[novau] customizing GRUB menu text…"

# ── Rename menu entries in BIOS grub.cfg ──────────────────────────────
GRUB_CFG=binary/boot/grub/grub.cfg
if [ -f "${GRUB_CFG}" ]; then
    # Rename the distribution name in menu entries
    sed -i 's/Debian GNU\/Linux Live/NovauOS/g' "${GRUB_CFG}"
    sed -i 's/debian-live/novauos-live/g' "${GRUB_CFG}"
    # Add splash to the kernel cmdline if not already there
    sed -i 's/boot=live components/boot=live components quiet splash/g' "${GRUB_CFG}"
    # Remove duplicate quiet/splash if the line already had them
    sed -i 's/quiet splash quiet splash/quiet splash/g' "${GRUB_CFG}"
    sed -i 's/  */ /g' "${GRUB_CFG}"
    echo "[novau] BIOS grub.cfg customized."
else
    echo "[novau] WARNING: binary/boot/grub/grub.cfg not found — skipping rename."
fi

# ── Rename menu entries in UEFI grub.cfg (if it exists) ───────────────
EFI_CFG=binary/EFI/BOOT/grub.cfg
if [ -f "${EFI_CFG}" ]; then
    sed -i 's/Debian GNU\/Linux Live/NovauOS/g' "${EFI_CFG}"
    sed -i 's/debian-live/novauos-live/g' "${EFI_CFG}"
    sed -i 's/boot=live components/boot=live components quiet splash/g' "${EFI_CFG}"
    sed -i 's/quiet splash quiet splash/quiet splash/g' "${EFI_CFG}"
    sed -i 's/  */ /g' "${EFI_CFG}"
    echo "[novau] UEFI grub.cfg customized."
fi

# ── Also handle grub-pc loopback config ───────────────────────────────
LOOPBACK_CFG=binary/boot/grub/loopback.cfg
if [ -f "${LOOPBACK_CFG}" ]; then
    sed -i 's/Debian GNU\/Linux Live/NovauOS/g' "${LOOPBACK_CFG}"
    sed -i 's/debian-live/novauos-live/g' "${LOOPBACK_CFG}"
    sed -i 's/boot=live components/boot=live components quiet splash/g' "${LOOPBACK_CFG}"
    sed -i 's/quiet splash quiet splash/quiet splash/g' "${LOOPBACK_CFG}"
    sed -i 's/  */ /g' "${LOOPBACK_CFG}"
    echo "[novau] loopback.cfg customized."
fi

# ── Copy GRUB background image if we have one ────────────────────────
# Only add the background_image line if the PNG actually exists on the ISO.
# A missing background file causes GRUB to print a warning but not fail.
GRUB_BG_SRC=/usr/share/backgrounds/novau/novau-grub.png
GRUB_BG_DST=binary/boot/grub/novau-grub.png
if [ -f "${GRUB_BG_SRC}" ]; then
    cp "${GRUB_BG_SRC}" "${GRUB_BG_DST}" 2>/dev/null || true
    # Add background_image to the top of grub.cfg (after the search line)
    if [ -f "${GRUB_CFG}" ]; then
        # Insert after the first 'set prefix' line
        sed -i '/^set prefix/a background_image /boot/grub/novau-grub.png' "${GRUB_CFG}"
    fi
fi

echo "[novau] GRUB customization done."
