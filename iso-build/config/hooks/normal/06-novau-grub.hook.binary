#!/bin/sh
# ─── binary hook: GRUB customization ──────────────────────────────────
#
# Runs after `lb binary` has assembled the EFI/BIOS tree. Customizes
# the GRUB menu so users see a polished boot menu instead of the
# default Debian one.
#
# We write TWO grub.cfg files:
#   1. binary/boot/grub/grub.cfg           — the loopback config that
#      live-build generates. We overwrite it with our own so the menu
#      is consistent across BIOS and UEFI boots.
#   2. binary/boot/grub/pc/grub/grub.cfg   — the BIOS-specific config
#      that the loopback config sources.
#
set -e

echo "[novau] customizing GRUB…"

# Live-build drops us into binary/ at this stage
GRUB_DIR=binary/boot/grub
GRUB_PC_DIR="${GRUB_DIR}/pc"
mkdir -p "${GRUB_PC_DIR}/grub"

# ── The menu contents (shared between BIOS and UEFI) ─────────────────
# This file is sourced by both the loopback grub.cfg and the BIOS grub.cfg.
MENU_CFG="${GRUB_PC_DIR}/grub/grub.cfg"
cat > "${MENU_CFG}" <<'EOF'
set default=0
set timeout=10

# Video + theme
insmod all_video
insmod gfxterm
insmod png
set gfxmode=auto
terminal_input console
terminal_output gfxterm

# NovauOS colour scheme: green accent on dark background
set color_normal=light-gray/black
set menu_color_normal=light-gray/black
set menu_color_highlight=green/black

# Splash image (if shipped on the ISO)
if [ -f /boot/grub/novau-grub.png ]; then
    background_image /boot/grub/novau-grub.png
fi

# ── Menu entries ────────────────────────────────────────────────────
# Following modern distro conventions (Ubuntu, Fedora, Tails), we have
# ONE primary entry that boots into the live session. From there, the
# user clicks "Install NovauOS" on the desktop or in the welcome app.
# This is simpler and more reliable than a separate installer kernel
# cmdline flag, and lets users explore the live session before
# committing to install.

menuentry "NovauOS (Live)" --class novau --class os {
    set gfxpayload=keep
    linux /live/vmlinuz boot=live components quiet splash ---
    initrd /live/initrd.img
}

menuentry "NovauOS (Safe graphics mode)" --class novau --class os {
    set gfxpayload=keep
    linux /live/vmlinuz boot=live components quiet splash nomodeset ---
    initrd /live/initrd.img
}

menuentry "NovauOS (Verbose boot)" --class novau --class os {
    set gfxpayload=keep
    linux /live/vmlinuz boot=live components ---
    initrd /live/initrd.img
}

if [ -e /boot/memtest86+.bin ]; then
    menuentry "Memory test (Memtest86+)" {
        linux16 /boot/memtest86+.bin
    }
fi
EOF

# ── Top-level loopback config (used by both BIOS and UEFI boot) ──────
# live-build writes its own grub.cfg here; we overwrite it so our menu
# is what users see. This file's job is to find the ISO's partition
# and source our menu config.
cat > "${GRUB_DIR}/grub.cfg" <<'EOF'
# Auto-generated by NovauOS build — do not edit.
# This is the top-level GRUB config that runs first on both BIOS and UEFI.
# It sets up the search for the ISO, then sources our menu config.

set default=0
set timeout=10

# Load required modules
insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod iso9660
insmod all_video
insmod gfxterm
insmod png
insmod progress
insmod linux

# Find the ISO's root partition. live-build labels it 'NOVAUOS <version>'.
# Fall back to searching by UUID if the label search fails.
search --no-floppy --set=root --file /live/vmlinuz

# Load the graphical terminal
set gfxmode=auto
terminal_input console
terminal_output gfxterm

# Source the actual menu (defined in pc/grub/grub.cfg above)
set prefix=($root)/boot/grub
source ${prefix}/pc/grub/grub.cfg
EOF

# Splash image (if shipped)
if [ -f /usr/share/backgrounds/novau/novau-grub.png ]; then
    cp /usr/share/backgrounds/novau/novau-grub.png "${GRUB_PC_DIR}/grub/novau-grub.png" 2>/dev/null || true
fi

echo "[novau] GRUB customization done."
