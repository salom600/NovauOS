#!/bin/sh
# ─── chroot hook: install NovauOS system config ────────────────────────
#
# Runs *inside* the chroot during `lb chroot`. Sets up:
#   - /etc/os-release with NovauOS branding
#   - /etc/pam.d/novau-greeter PAM service
#   - systemd services for the greeter & panel
#   - Polkit rules so the store can install packages
#   - accountsservice face directory
#
set -e

echo "[novau] applying system configuration…"

# ── /etc/os-release ───────────────────────────────────────────────────
cat > /etc/os-release <<'EOF'
NAME="NovauOS"
VERSION="0.1.0 (aurora)"
ID=novauos
ID_LIKE=debian
PRETTY_NAME="NovauOS 0.1.0 (aurora)"
VERSION_ID="0.1"
VERSION_CODENAME=aurora
HOME_URL="https://github.com/salom600/NovauOS"
SUPPORT_URL="https://github.com/salom600/NovauOS/issues"
BUG_REPORT_URL="https://github.com/salom600/NovauOS/issues"
BUILD_ID="0"
EOF

# Symlink /etc/default-release if missing (some apps read it)
ln -sf /etc/os-release /usr/lib/os-release 2>/dev/null || true

# ── /etc/hostname / hosts ─────────────────────────────────────────────
echo "novauos" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1   localhost
127.0.1.1   novauos

::1         localhost ip6-localhost ip6-loopback
ff02::1     ip6-allnodes
ff02::2     ip6-allrouters
EOF

# ── PAM service for the greeter ───────────────────────────────────────
cat > /etc/pam.d/novau-greeter <<'EOF'
# PAM config for the NovauOS greeter. Mirrors common-auth + common-account
# but skips the "have you logged in recently" checks that would prevent
# the greeter itself from authenticating.

auth        required    pam_env.so readenv=1
auth        required    pam_unix.so nullok try_first_pass
auth        optional    pam_gnome_keyring.so

account     required    pam_unix.so

password    required    pam_unix.so sha512 shadow nullok try_first_pass use_authtok
password    optional    pam_gnome_keyring.so

session     required    pam_unix.so
session     optional    pam_loginuid.so
session     optional    pam_systemd.so
session     optional    pam_gnome_keyring.so auto_start
session     required    pam_env.so readenv=1
EOF

# ── Sudoers: allow members of `sudo` and `wheel` to escalate ─────────
cat > /etc/sudoers.d/novau <<'EOF'
# Members of the `sudo` group may run any command without a password
# (single-user desktop convenience; lock down on multi-user installs).
%sudo   ALL=(ALL) NOPASSWD: ALL
%wheel  ALL=(ALL) NOPASSWD: ALL

# The novau-store helper can install packages without further auth.
Cmnd_Alias NOVAU_STORE = /usr/bin/apt-get install *, /usr/bin/apt-get remove *, /usr/bin/flatpak install *, /usr/bin/flatpak uninstall *
novau-store ALL=(root) NOPASSWD: NOVAU_STORE
EOF
chmod 0440 /etc/sudoers.d/novau

# ── systemd targets ──────────────────────────────────────────────────
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sf /usr/lib/systemd/system/novau-greeter.service /etc/systemd/system/display-manager.service
ln -sf /usr/lib/systemd/system/novau-greeter.service /etc/systemd/system/graphical.target.wants/novau-greeter.service

# Default to graphical target
systemctl set-default graphical.target 2>/dev/null || true

echo "[novau] system configuration applied."
