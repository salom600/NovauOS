#!/bin/sh
# ─── chroot hook: install systemd unit files for NovauOS components ───
#
# These service files are installed into /usr/lib/systemd/system during
# the chroot phase. They reference the Rust binaries that the host's
# build.sh has already copied into includes.chroot/usr/bin/.
#
# KEY FIX (commit history): the greeter used to run /usr/bin/novau-greeter
# directly on tty1 with no Wayland compositor, which caused iced/winit
# to panic with "neither WAYLAND_DISPLAY nor WAYLAND_SOCKET nor DISPLAY
# is set". We now wrap the greeter in `cage`, a tiny kiosk Wayland
# compositor that runs a single app fullscreen. This is the standard
# approach used by gtkgreet, wayfire-based greeters, etc.
#
set -e

echo "[novau] installing systemd unit files…"

mkdir -p /usr/lib/systemd/system

# ── Greeter ──────────────────────────────────────────────────────────
# cage is a kiosk Wayland compositor. It starts on tty1, creates a
# Wayland display, and runs novau-greeter inside it fullscreen.
# The greeter then authenticates via PAM and launches the user's
# session (which uses sway as its compositor).
cat > /usr/lib/systemd/system/novau-greeter.service <<'EOF'
[Unit]
Description=NovauOS Greeter (Wayland login screen, cage kiosk)
Documentation=https://github.com/salom600/NovauOS
After=systemd-user-sessions.service plymouth-quit.service systemd-logind.service
Wants=plymouth-quit.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
# cage is the kiosk Wayland compositor. It starts on tty1, sets up a
# Wayland display, and runs /usr/bin/novau-greeter fullscreen.
# WLR_RENDERER_ALLOW_SOFTWARE=1 lets cage fall back to software rendering
# if no GPU driver is loaded yet (e.g. on first boot with NVIDIA).
# XKB_DEFAULT_LAYOUT=us is the default keyboard layout; users can change
# it from Settings after first login.
ExecStart=/usr/bin/cage -d -- /usr/bin/novau-greeter
Restart=always
RestartSec=3
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=mixed
IgnoreSIGPIPE=no
SendSIGHUP=yes
User=root
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/novau-greeter
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=XKB_DEFAULT_LAYOUT=us
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
RuntimeDirectory=novau-greeter
RuntimeDirectoryMode=0755
PAMName=login

[Install]
Alias=display-manager.service
WantedBy=graphical.target
EOF

# ── Per-user panel (started via systemd --user) ──────────────────────
mkdir -p /usr/lib/systemd/user
cat > /usr/lib/systemd/user/novau-panel.service <<'EOF'
[Unit]
Description=NovauOS Panel
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/novau-panel
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
EOF

cat > /usr/lib/systemd/user/novau-settings-daemon.service <<'EOF'
[Unit]
Description=NovauOS Settings Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/novau-settings
Restart=on-failure
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
EOF

# ── Welcome (auto-starts in live mode; first-boot only on installed system) ──
# In live mode the user needs to see the "Install NovauOS" button every
# time, so we don't mask the service there. On an installed system the
# onboarding-complete flag masks it after the first run.
cat > /usr/lib/systemd/user/novau-welcome.service <<'EOF'
[Unit]
Description=NovauOS Welcome & Onboarding
After=graphical-session.target
# On an installed system, mask after onboarding completes.
# In live mode (NOVAU_LIVE=1 set by /etc/profile.d/novau.sh), always run.
ConditionPathExists=!%E/novau/onboarding-complete

[Service]
Type=simple
ExecStart=/usr/bin/novau-welcome
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=graphical-session.target
EOF

# ── Novau session target ────────────────────────────────────────────
cat > /usr/lib/systemd/user/novau-session.target <<'EOF'
[Unit]
Description=NovauOS Session
Wants=graphical-session.target
After=graphical-session.target
Requires=novau-panel.service novau-settings-daemon.service
EOF

# ── Wayland session desktop file ────────────────────────────────────
# This is what the greeter launches when the user picks "NovauOS" from
# the session picker. It starts sway with our config; sway then starts
# the novau-panel, novau-settings, and novau-welcome as user services.
mkdir -p /usr/share/wayland-sessions
cat > /usr/share/wayland-sessions/novau.desktop <<'EOF'
[Desktop Entry]
Name=NovauOS
Comment=The NovauOS Rust desktop session
Exec=sway -c /etc/novau/sway.conf
Type=Application
DesktopNames=Novau
EOF

# ── Polkit autostart so the store can install packages ──────────────
# We need a polkit authentication agent running in the session for
# pkexec to pop up a password dialog. lxpolkit is the lightest one.
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/novau-polkit.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=PolicyKit Authentication Agent
Comment=Polkit agent for NovauOS
Exec=/usr/bin/lxpolkit
Terminal=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=Novau;
EOF

# ── Desktop shortcut: Install NovauOS (visible on live desktop) ─────
mkdir -p /etc/skel/Desktop
cat > /etc/skel/Desktop/install-novauos.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install NovauOS
Name[ar]=تثبيت NovauOS
Name[es]=Instalar NovauOS
Name[fr]=Installer NovauOS
Comment=Install NovauOS on your computer
Comment[ar]=قم بتثبيت NovauOS على جهاز الكمبيوتر الخاص بك
Comment[es]=Instale NovauOS en su computadora
Comment[fr]=Installez NovauOS sur votre ordinateur
Icon=system-software-install
Exec=/usr/bin/novau-installer
Terminal=false
Categories=System;
X-GNOME-Autostart-enabled=true
EOF
chmod 0755 /etc/skel/Desktop/install-novauos.desktop

# Also place it on the live user's desktop (the live user is created by
# live-boot; we put it in /etc/skel so it's copied to any new user, but
# the live user is typically created BEFORE our hook runs, so we also
# place it directly in /home for the live user).
LIVE_USER_HOME=$(getent passwd user 2>/dev/null | cut -d: -f6 || true)
if [ -n "${LIVE_USER_HOME}" ] && [ -d "${LIVE_USER_HOME}" ]; then
    mkdir -p "${LIVE_USER_HOME}/Desktop"
    cp /etc/skel/Desktop/install-novauos.desktop "${LIVE_USER_HOME}/Desktop/"
    chown -R user:user "${LIVE_USER_HOME}/Desktop" 2>/dev/null || true
fi

echo "[novau] systemd units installed."
